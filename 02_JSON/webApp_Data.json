# Web App Navigator - JSON Generator
# Generate_JSON-webApp_Data-by_MS_PowerShell-Chunks20K
#
# Power Query is refreshed manually before running this script.
#
# Power Query generates the JSON in 20,000-character chunks.
# Each chunk is stored in column A of the worksheet:
# Json_Data-Chunks20K
#
# This script dynamically detects the last populated row,
# reconstructs the complete JSON, and writes it to:
# C:\Beni_WebApp\02_JSON\webApp_Data.json

$ExcelFile = "C:\Beni_WebApp\01_BackOffice\Beni_WebApp_Data_and_Config.xlsx"

$SheetName = "Json_Data-Chunks20K"
$StartRow = 2
$ColumnNumber = 1       # Column A

$OutputFolder = "C:\Beni_WebApp\02_JSON"
$OutputFile = Join-Path $OutputFolder "webApp_Data.json"

Write-Host "Web App Navigator - Data JSON Exporter"
Write-Host "--------------------------------------"

# ------------------------------------------------------------
# Check Excel file
# ------------------------------------------------------------

if (-not (Test-Path $ExcelFile)) {

    Write-Host "ERROR: Excel file not found:"
    Write-Host $ExcelFile

    exit 1
}

# ------------------------------------------------------------
# Create output folder if necessary
# ------------------------------------------------------------

if (-not (Test-Path $OutputFolder)) {

    New-Item `
        -ItemType Directory `
        -Path $OutputFolder `
        -Force | Out-Null
}

$Excel = $null
$Workbook = $null
$Worksheet = $null

try {

    # --------------------------------------------------------
    # Open Excel
    # --------------------------------------------------------

    Write-Host "Opening Excel workbook..."

    $Excel = New-Object -ComObject Excel.Application

    $Excel.Visible = $false
    $Excel.DisplayAlerts = $false

    $Workbook = $Excel.Workbooks.Open(
        $ExcelFile,
        0,
        $true
    )

    # --------------------------------------------------------
    # Open worksheet
    # --------------------------------------------------------

    Write-Host "Reading $SheetName..."

    $Worksheet = $Workbook.Worksheets.Item($SheetName)

    # --------------------------------------------------------
    # Dynamically determine the last populated row in column A
    #
    # Excel constant xlUp = -4162
    # --------------------------------------------------------

    $LastRow = $Worksheet.Cells(
        $Worksheet.Rows.Count,
        $ColumnNumber
    ).End(-4162).Row

    # --------------------------------------------------------
    # Validate that data exists
    # --------------------------------------------------------

    if ($LastRow -lt $StartRow) {

        throw "No JSON chunks found in column A of worksheet '$SheetName'."
    }

    # Number of chunks
    $ChunkCount = $LastRow - $StartRow + 1

    Write-Host "JSON chunks found: $ChunkCount"
    Write-Host "Reading rows: A$StartRow to A$LastRow"

    # --------------------------------------------------------
    # Reconstruct JSON
    # --------------------------------------------------------

    $JsonBuilder = New-Object System.Text.StringBuilder

    for ($Row = $StartRow; $Row -le $LastRow; $Row++) {

        $Chunk = $Worksheet.Cells(
            $Row,
            $ColumnNumber
        ).Value2

        if ($null -ne $Chunk) {

            [void]$JsonBuilder.Append(
                [string]$Chunk
            )
        }
    }

    # --------------------------------------------------------
    # Convert StringBuilder to final JSON text
    # --------------------------------------------------------

    $JsonText = $JsonBuilder.ToString()

    if ([string]::IsNullOrWhiteSpace($JsonText)) {

        throw "The reconstructed JSON is empty."
    }

    # --------------------------------------------------------
    # Display reconstructed JSON information
    # --------------------------------------------------------

    Write-Host "JSON reconstructed."
    Write-Host "JSON length: $($JsonText.Length)"

    # --------------------------------------------------------
    # Write JSON file
    #
    # UTF-8 without BOM
    # --------------------------------------------------------

    [System.IO.File]::WriteAllText(
        $OutputFile,
        $JsonText,
        [System.Text.UTF8Encoding]::new($false)
    )

    # --------------------------------------------------------
    # Success
    # --------------------------------------------------------

    Write-Host ""
    Write-Host "SUCCESS!"
    Write-Host "Created:"
    Write-Host $OutputFile

}
catch {

    # --------------------------------------------------------
    # Error handling
    # --------------------------------------------------------

    Write-Host ""
    Write-Host "ERROR:"
    Write-Host $_.Exception.Message

    exit 1
}
finally {

    # --------------------------------------------------------
    # Close worksheet COM object
    # --------------------------------------------------------

    if ($Worksheet) {

        [System.Runtime.Interopservices.Marshal]::ReleaseComObject(
            $Worksheet
        ) | Out-Null
    }

    # --------------------------------------------------------
    # Close workbook
    # --------------------------------------------------------

    if ($Workbook) {

        $Workbook.Close($false)

        [System.Runtime.Interopservices.Marshal]::ReleaseComObject(
            $Workbook
        ) | Out-Null
    }

    # --------------------------------------------------------
    # Quit Excel
    # --------------------------------------------------------

    if ($Excel) {

        $Excel.Quit()

        [System.Runtime.Interopservices.Marshal]::ReleaseComObject(
            $Excel
        ) | Out-Null
    }

    # --------------------------------------------------------
    # Clean up COM objects
    # --------------------------------------------------------

    [GC]::Collect()
    [GC]::WaitForPendingFinalizers()
}
